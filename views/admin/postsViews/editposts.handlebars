{{> _erros}}

<h2>Editar Posts <i class="bi bi-file-earmark-plus-fill"></i></h2>

<div class="card">
    <div class="card-body">

        <form action="/admin/posts/edit" method="post">

            <input type="hidden" name="id" value="{{posts._id}}">

            <label for="titulo" class="mt-2">Titulo: </label>
              <input type="text" name="titulo" id="titulo" placeholder="Titulo do Post" class="form-control mt-3" value="{{posts.titulo}}" >
            <label for="slug" class="mt-2">Slug:</label>
                <input type="text" name="slug" id="slug" placeholder="Slug do Post" class="form-control mt-3" value="{{posts.slug}}" >

            <label for="descricao" class="mt-2">Descrição:</label>
                <input type="text" name="descricao" id="descricao" placeholder="Descrição do Post" class="form-control mt-3" value="{{posts.descricao}}" >

            <label for="conteudo" class="mt-2">Conteúdo:</label>
                <textarea name="conteudo" id="conteudo" class="mt-3 form-control" rows="6" placeholder="Conteudo do Post">{{posts.conteudo}}</textarea>

            <label for="categoria" class="mt-2">Categoria:</label>
            <select name="categoria" class="form-select mt-2">

                {{#each categorias}}
                <option value="{{_id}}">{{nome}}</option>
                {{else}}
                <option value="0">Nenhuma categoria encontrada.</option>
                {{/each}}
                
            </select>

            <button  type="submit" class="btn btn-outline-primary mt-3">Confirmar</button>

        </form>
    </div>
</div>