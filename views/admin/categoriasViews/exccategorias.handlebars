<h2>Excluir categorias <i class="bi bi-trash3-fill"></i></h2>
<hr>
 <div class="container mt-4">
    <div class="row">
        {{#each categorias}}
            <div class="col-md-6 mb-4">
                <div class="card border-info shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="card-title">{{nome}}</h4>
                            <small class="text-muted d-block">{{slug}}</small>
                            <small class="text-secondary data-formatada d-block">{{date}}</small>
                            <br>
                            <form action="/admin/categorias/deletado/{{_id}}" method="post">
                            <button type="submit"  class="btn-delete-custom">Deletar</button>
                            </form>
                    </div>
                </div>
            </div>
        {{else}}
            <p>Categoria nao encontrada</p>
        {{/each}}
    </div>
 </div>