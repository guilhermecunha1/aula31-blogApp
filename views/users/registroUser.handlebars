
{{>_erros}}
<a href="/"><button class="btn-custom w-40">Voltar</button></a>

<div class="d-flex justify-content-center align-items-center vh-100">

  <div class="card auth-card shadow-lg p-4">

    <h3 class="text-center mb-2">Criar Conta</h3>
    <p class="text-center text-white mb-4">Preencha os dados abaixo</p>

    <form action="/users/cadastro" method="POST">

      <div class="mb-3">
        <input type="text" name="nome" class="form-control" placeholder="Nome" value="{{oldInput.nome}}" >
      </div>

      <div class="mb-3">
        <input type="email" name="email" class="form-control" placeholder="Email" value="{{oldInput.email}}">
      </div>

      <div class="mb-3">
        <input type="password" name="senha" class="form-control"  placeholder="Senha"aria-describedby="passwordHelpInline">
        <div id="passwordHelpBlock" class="form-text">
         Senha deve conter entre 8-20 carácteres.
        </div>
      </div>

      <div class="mb-3">
        <input type="password" name="senha2" class="form-control" placeholder="Confirmar senha" >
      </div>
      <hr>

      <button type="submit" class="btn-custom w-100 mx-auto d-block mb-3">Cadastrar</button>
    </form>
    <small class="text-center"> Já possui uma conta ? </small>
      <a href="/users/login"><button class="btn-custom w-100 mx-auto d-block mt-2">Entrar em conta ja existente</button></a>
    
  </div>
</div>