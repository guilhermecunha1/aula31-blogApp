<h2>Posts com categoria {{categoria.nome}} <i class="bi bi-journal-text"></i></h2>
<hr>

<div class="container mt-4">
  <div class="row">
    {{#each posts}}
      <div class="col-md-6 mb-4">
        <div class="card border-info shadow-sm h-100">
          <div class="card-body">

            <h4 class="card-title mb-1">{{titulo}}</h4>

            <small class="text-muted d-block mb-2">
              Slug: {{slug}}
            </small>

            <small class="text-secondary data-formatada d-block mb-3">
              Publicado em: {{date}}
            </small>

            <p class="mt-2 mb-3">
              {{descricao}}
            </p>
            <a href="/post/{{slug}}"><button class="btn btn-outline-primary mt-3">Leia mais</button></a>

            <hr>
          </div>
        </div>
      </div>
    {{else}}
      <p class="mt-3">Nenhum post encontrado com a categoria de {{categoria.nome}}</p>
    {{/each}}
  </div>
</div>