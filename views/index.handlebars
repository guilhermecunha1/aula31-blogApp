
<div class="container mt-4">
  <div class="jumbotron-custom p-5 rounded-4 text-white">
    <h1 class="display-5 fw-bold">Bem-vindo ao Blog App</h1>
    <p class="col-md-8 fs-5">
      {{#if user}}
      Explore posts com categorias do seu gosto e gerencie seus proprios posts de forma simples e rapida !
      {{else}}
      Crie uma conta para poder gerenciar seus posts, categorias e muito mais de forma simples e rápida.
      {{/if}}
    </p>
    {{#if user}}
    {{else}}
    <a href="/users/registro">
      <button class="btn btn-light btn-lg mt-3">Criar uma Conta</button>
    </a>
    {{/if}}
  </div>
</div>
<hr>

<h4 class="title"> Posts Recentes: </h4>
<br>

<div class="scroll-posts">
  {{#each posts}}
    <div class="card-post">
      <h5 class="post-title">{{titulo}}</h5>

      <p class="post-desc">
        {{descricao}}
      </p>

      <div class="post-footer">
        <span class="categoria">{{categoria.nome}}</span>
        <span class="data-formatada">{{date}}</span>
      </div>
          <a href="/post/{{slug}}"><button class="btn btn-outline-primary mt-3">Leia mais</button></a>
    </div>

  {{/each}}
</div>
<br>
<h4 class="title">Categorias Recentes</h4>
<div class="scroll-categorias mt-4">
  {{#each categorias}}
    <div class="card-categoria">

      <h5 class="categoria-titulo">{{nome}}</h5>

      <small class="categoria-slug">{{slug}}</small>
      <small class="data-formatada">{{date}}</small>
      <br>
      <a href="/categorias/{{slug}}"><button class="btn btn-outline-success mt-3">Leia mais</button></a>
    </div>
  {{else}}
    <p>Nenhuma categoria encontrada.</p>
  {{/each}}
</div>
<br><br>


 {{!Parte de Script dos Scroll's}}
<script id="fixscroll1">
  document.querySelectorAll('.scroll-posts, .scroll-categorias').forEach(container => {
    container.addEventListener('wheel', (e) => {
      if (e.deltaY === 0) return;

      e.preventDefault();

      container.scrollBy({
        left: e.deltaY,
        behavior: 'smooth'
      });
    });
  });
</script>

